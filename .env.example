# Spend Tracker API Environment Configuration

# Core Application Settings
PROJECT_NAME="Spend Tracker API"
DEBUG=False
LOG_LEVEL=INFO

# Database Connection (AsyncPG + PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/matumizi

# Redis Connection (Rate limiting and budget alert idempotency)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=super-secret-production-grade-matumizi-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT=100/minute
